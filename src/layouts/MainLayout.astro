---
import "../styles/global.css"
import Head from "../components/Head.astro"

const {title, description, image, pathname = Astro.url.pathname} = Astro.props
---

<html lang="en">
	<Head
		title={title}
		description={description}
		image={image}
		pathname={pathname}
	>
		<slot name="head" />
	</Head>

	<body>
		<slot />
	</body>
</html>
