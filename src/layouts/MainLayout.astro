---
import "../styles/global.css"
import Head from "../components/Head.astro"

const {
	title,
	description,
	image,
	pathname = Astro.url.pathname, // auto-detect current path
} = Astro.props
---

<html lang="en">
	<Head
		title={title}
		description={description}
		image={image}
		pathname={pathname}
	/>
	<body>
		<slot />
	</body>
</html>
