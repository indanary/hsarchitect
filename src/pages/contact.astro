---
import MainLayout from "../layouts/MainLayout.astro"
import ContactContent from "../components/contact/ContactContent"

const title = "Contact"
const description =
	"Contact hsarchitect for general inquiries, project consultations, studio visits, or appointments. Reach us via phone, email, or visit our studio in Ngesrep Timur II, Banyumanik, Semarang."
const image = "/images/hsarchitect-logo-light.png"
const pathname = Astro.url.pathname
---

<MainLayout {title} {description} {image} {pathname}>
	<ContactContent client:load />
</MainLayout>
