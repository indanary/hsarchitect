---
import MainLayout from "../layouts/MainLayout.astro"
import ContactContent from "../components/contact/ContactContent"

const title = "Contact — HS Architect"
const description =
	"Contact HS Architect for general inquiries, project consultations, or studio visits. Reach us by email, phone, or visit our studio in Semarang, Indonesia."
const image = "/images/hsarchitect-logo-light.png"
const pathname = Astro.url.pathname
---

<MainLayout {title} {description} {image} {pathname}>
	<ContactContent client:load />
</MainLayout>
