---
import MainLayout from "../layouts/MainLayout.astro"
import SearchContent from "../components/search/SearchContent"

const title = "Search"
const description =
	"Search hsarchitect architectural projects by name, category, or keyword."
const image = "/images/hsarchitect-logo-light.png" // your OG image
const pathname = Astro.url.pathname
---

<MainLayout {title} {description} {image} {pathname}>
	<SearchContent client:load />
</MainLayout>
