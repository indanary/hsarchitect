---
// index.astro
import MainLayout from "../layouts/MainLayout.astro"
import HomeContent from "../components/home/HomeContent"

const title = "HS Architect — Architecture Portfolio & Studio"
const description =
	"HS Architect is an architecture studio based in Semarang, Indonesia, showcasing selected architectural projects, design portfolio, and studio profile."
const image = "/images/hsarchitect-logo-light.png"
const pathname = Astro.url.pathname
---

<MainLayout {title} {description} {image} {pathname}>
	<HomeContent client:idle />
</MainLayout>
