---
import fs from "fs"
import path from "path"
import MainLayout from "../../layouts/MainLayout.astro"
import ProjectDetailContent from "../../components/projects/detail/ProjectDetailContent"

export async function getStaticPaths() {
	// Try build-time inputs:
	// 1) PRERENDER_SLUGS environment variable (set by CI): either JSON array or CSV
	// 2) prerender-slugs.json file created by CI
	const tryFromEnv = () => {
		try {
			const raw = import.meta.env.PRERENDER_SLUGS || ""
			if (!raw) return []
			// try parse as JSON array
			try {
				const parsed = JSON.parse(raw)
				if (Array.isArray(parsed)) return parsed.map(String)
			} catch (e) {
				// not JSON — try CSV
				return raw
					.split(",")
					.map((s) => s.trim())
					.filter(Boolean)
					.map(String)
			}
		} catch (e) {
			return []
		}
		return []
	}

	const tryFromFile = () => {
		try {
			const jsonPath = path.resolve("./prerender-slugs.json")
			if (fs.existsSync(jsonPath)) {
				const raw = fs.readFileSync(jsonPath, "utf-8")
				const parsed = JSON.parse(raw || "[]")
				if (Array.isArray(parsed)) return parsed.map(String)
			}
		} catch (e) {}
		return []
	}

	let ids = tryFromEnv()
	if (ids.length === 0) ids = tryFromFile()

	// 🔑 Clean & normalize ids: trim, drop empty, drop "__ALL__", dedupe
	ids = Array.from(
		new Set(
			ids
				.map(String)
				.map((s) => s.trim())
				.filter(Boolean)
				.filter((s) => s !== "__ALL__"),
		),
	)

	if (ids.length > 0) {
		// Provided selective ids — generate only these pages
		return ids.map((id) => ({params: {id: String(id)}}))
	}

	// Fallback: fetch all publicly available projects (original behavior)
	const BASE = import.meta.env.PUBLIC_API_BASE_URL
	if (!BASE) {
		return []
	}

	try {
		const r = await fetch(`${BASE}/projects/public`, {
			cache: "no-store",
		}).catch(() => null)
		const projects = r?.ok ? await r.json() : []
		return projects.map((p) => ({params: {id: String(p.id)}}))
	} catch (err) {
		return []
	}
}

const BASE = import.meta.env.PUBLIC_API_BASE_URL
const {id} = Astro.params

let initialProject = null
if (BASE) {
	try {
		const r = await fetch(
			`${BASE}/projects/public/${encodeURIComponent(id)}`,
			{cache: "no-store"},
		)
		if (r.ok) initialProject = await r.json()
	} catch (err) {
		// ignore; initialProject stays null
	}
}

if (!initialProject) {
	throw new Response(null, {status: 404})
}

// Helpers for SEO-friendly meta values
const safeText = (s) => (typeof s === "string" ? s.trim() : "")
const truncate = (s, n = 155) =>
	s && s.length > n ? `${s.slice(0, n - 1).trim()}…` : s

// Title
const title = initialProject?.title
	? `${safeText(initialProject.title)} | hsarchitect.id`
	: "Project Detail | hsarchitect.id"

// Description: prefer explicit summary -> description -> fallback text
const rawDesc =
	safeText(initialProject?.summary) ||
	safeText(initialProject?.description) ||
	"Project detail page for hsarchitect — design, images, and project information."
const description = truncate(rawDesc, 155)

// Image: prefer project cover, otherwise site logo
const maybeImage = initialProject?.cover || "/images/hsarchitect-logo-light.png"
const image = maybeImage.startsWith("http")
	? maybeImage
	: maybeImage.startsWith("/")
		? maybeImage
		: `/${maybeImage}`

// Pathname for canonical
const pathname =
	Astro.url && Astro.url.pathname
		? Astro.url.pathname
		: `/projects/${encodeURIComponent(id)}`
---

<MainLayout
	title={title}
	description={description}
	image={image}
	pathname={pathname}
>
	<ProjectDetailContent id={id} initialProject={initialProject} client:load />
</MainLayout>
