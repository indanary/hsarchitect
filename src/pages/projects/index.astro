---
import MainLayout from "../../layouts/MainLayout.astro"
import ProjectListContent from "../../components/projects/list/ProjectListContent"

const title = "Projects — HS Architect"
const description =
	"Explore HS Architect’s architectural projects — residential, commercial, and conceptual works designed in Semarang and beyond."
const image = "/images/hsarchitect-logo-light.png"
const pathname = Astro.url.pathname

const BASE = import.meta.env.PUBLIC_API_BASE_URL

if (!BASE) {
	throw new Error("PUBLIC_API_BASE_URL is required for Projects page build.")
}

let categories = []
let initialProjects = []

try {
	const url = `${BASE}/project-types/public`

	const r = await fetch(url, {cache: "no-store"})

	if (!r.ok) {
		throw new Error(
			`Failed to load project types: ${r.status} ${r.statusText}`,
		)
	}

	categories = await r.json()
} catch (err) {
	throw err
}

try {
	const projUrl = `${BASE}/projects/public`

	const r2 = await fetch(projUrl, {cache: "no-store"})

	if (r2.ok) {
		initialProjects = await r2.json()
	}
} catch (err) {}
---

<MainLayout {title} {description} {image} {pathname}>
	<ProjectListContent
		client:visible
		categories={categories}
		initialProjects={initialProjects}
	/>
</MainLayout>
