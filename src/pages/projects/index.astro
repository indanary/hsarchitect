---
import MainLayout from "../../layouts/MainLayout.astro"
import ProjectListContent from "../../components/projects/list/ProjectListContent"

const title = "Projects"
const description =
	"Explore hsarchitect architectural projects — residential, commercial, and conceptual works designed in Semarang and beyond."
const image = "/images/hsarchitect-logo-light.png"
const pathname = Astro.url.pathname

// 🔑 Build an absolute URL for the backend API
const apiBase = import.meta.env.PUBLIC_API_BASE_URL

// new URL() guarantees a valid absolute URL
const categoriesUrl = new URL("/project-types/public", apiBase).toString()

const res = await fetch(categoriesUrl)

if (!res.ok) {
	throw new Error(
		`Failed to load project types: ${res.status} ${res.statusText}`,
	)
}

const categories = await res.json()
---

<MainLayout {title} {description} {image} {pathname}>
	<ProjectListContent client:load categories={categories} />
</MainLayout>
